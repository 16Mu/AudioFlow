<Window x:Class="AudioFlow.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:n="https://miroiu.github.io/nodify" xmlns:vm="clr-namespace:AudioFlow.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="声流 AudioFlow · 声音配置" Width="1420" Height="920" MinWidth="1120" MinHeight="740" WindowStartupLocation="CenterScreen" Foreground="{DynamicResource Text.Primary}" Background="{DynamicResource Surface.Window}" WindowStyle="None" ResizeMode="CanResize" xmlns:theme="clr-namespace:AudioFlow.App">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" CornerRadius="{DynamicResource Radius.Control}" GlassFrameThickness="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
  <Window.InputBindings><KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" /><KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" /><KeyBinding Key="Delete" Command="{Binding DeleteCommand}" /></Window.InputBindings>
  <Window.Resources>
    <DataTemplate x:Key="RouteVolumeRow">
      <Border Background="{DynamicResource Surface.Control}" CornerRadius="{DynamicResource Radius.Control}" Padding="8" Margin="0,0,0,6" ToolTip="{Binding Help}">
        <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text.Secondary}" FontSize="{DynamicResource FontSize.Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MouseLeftButtonDown="RouteRowSelected" /><Button Grid.Column="1" Content="×" Click="DeleteRouteClick" Visibility="{Binding CanRemove,Converter={StaticResource BoolVisibility}}" Style="{StaticResource QuietButton}" Padding="2,0" FontSize="{DynamicResource FontSize.Body}" ToolTip="断开这条连接" /></Grid>
          <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="43" /></Grid.ColumnDefinitions><Slider Value="{Binding Volume,Mode=TwoWay}" Minimum="0" Maximum="1" ToolTip="{Binding Help}" /><TextBlock Grid.Column="1" Text="{Binding VolumeLabel}" Foreground="{DynamicResource Text.Secondary}" FontSize="{DynamicResource FontSize.Caption}" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid>
        </StackPanel>
      </Border>
    </DataTemplate>
    <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource QuietButton}"></Style>


    <DataTemplate x:Key="Choice"><StackPanel><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="276" FontSize="{DynamicResource FontSize.Body}" /><TextBlock Text="{Binding Hint}" Foreground="{DynamicResource Text.Muted}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,3,0,0" /></StackPanel></DataTemplate>
    <DataTemplate x:Key="PortLabel"><Border Background="{DynamicResource Surface.Tag}" CornerRadius="{DynamicResource Radius.Tag}" Padding="5,3"><TextBlock Text="{Binding}" Foreground="{DynamicResource Text.Secondary}" FontSize="{DynamicResource FontSize.Caption}" TextWrapping="NoWrap" /></Border></DataTemplate>
    <DataTemplate x:Key="InputPort"><n:NodeInput Anchor="{Binding Anchor,Mode=OneWayToSource}" IsConnected="True" Background="{DynamicResource Transparent}" Foreground="{Binding Color}" Header="{Binding Name}" HeaderTemplate="{StaticResource PortLabel}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,2" PendingConnectionCompleted="PortConnectionCompleted" ToolTip="拖动左边的圆点可以换个声音去处。有多条线时，先点选你想移动的那条。" PendingConnectionStarted="PortConnectionStarted" /></DataTemplate>
    <DataTemplate x:Key="OutputPort"><n:NodeOutput Anchor="{Binding Anchor,Mode=OneWayToSource}" IsConnected="True" Background="{DynamicResource Transparent}" Foreground="{Binding Color}" Header="{Binding Name}" HeaderTemplate="{StaticResource PortLabel}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,2" PendingConnectionCompleted="PortConnectionCompleted" ToolTip="拖动左边的圆点可以换个声音去处。有多条线时，先点选你想移动的那条。" PendingConnectionStarted="PortConnectionStarted" /></DataTemplate>
    <Style x:Key="ApplicationViewButton" TargetType="Button" BasedOn="{StaticResource Quiet}"><Setter Property="Foreground" Value="{DynamicResource Text.Muted}" /><Style.Triggers><DataTrigger Binding="{Binding GlobalView}" Value="False"><Setter Property="Foreground" Value="{DynamicResource Accent.Output}" /><Setter Property="Background" Value="{DynamicResource Surface.View.Application}" /></DataTrigger></Style.Triggers></Style>
    <Style x:Key="GlobalViewButton" TargetType="Button" BasedOn="{StaticResource Quiet}"><Setter Property="Foreground" Value="{DynamicResource Text.Muted}" /><Style.Triggers><DataTrigger Binding="{Binding GlobalView}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent.Global}" /><Setter Property="Background" Value="{DynamicResource Surface.View.Global}" /></DataTrigger></Style.Triggers></Style>
  </Window.Resources>
  <Border Background="{DynamicResource Surface.Window}" CornerRadius="{DynamicResource Radius.Control}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1">
    <Grid><Grid.RowDefinitions><RowDefinition Height="46" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Border Background="{DynamicResource Surface.Title}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,0,0,1" Padding="18,0,7,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="/Assets/app-icon.png" Width="26" Height="26" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" /><TextBlock Text="声流 AudioFlow" FontSize="{DynamicResource FontSize.Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding VersionLabel}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource FontSize.Caption}" Foreground="{DynamicResource Text.Muted}" Margin="13,4,0,0" /></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center">
            <TextBlock Text="{Binding LiveSummary}" Foreground="{DynamicResource Text.Muted}" FontSize="{DynamicResource FontSize.Caption}" VerticalAlignment="Center" Margin="0,0,14,0" /><Button Content="⚙" Click="SettingsClick" Style="{StaticResource Quiet}" AutomationProperties.Name="设置" /><Button Content="—" Click="MinimizeClick" Style="{StaticResource Quiet}" Width="42" /><Button Content="□" Click="MaximizeClick" Style="{StaticResource Quiet}" Width="42" /><Button Content="×" Click="CloseClick" Style="{StaticResource Quiet}" Width="42" FontSize="{DynamicResource FontSize.Heading}"><Button.ContextMenu><ContextMenu><MenuItem Header="退出声流" Click="ExitClick" /></ContextMenu></Button.ContextMenu></Button>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource Surface.Panel}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,0,1,0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="68" /><RowDefinition Height="46" /><RowDefinition Height="*" /><RowDefinition Height="65" /></Grid.RowDefinitions>
            <StackPanel Margin="19,17,10,0"><TextBlock Text="选择软件" FontSize="{DynamicResource FontSize.Title}" FontWeight="SemiBold" /><TextBlock Text="正在发声的软件排在前面" Foreground="{DynamicResource Text.Muted}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,5,0,0" /></StackPanel>
            <TextBox Grid.Row="1" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Margin="17,4,17,10" AutomationProperties.Name="搜索软件名称" ToolTip="输入软件名称，查找你想设置的软件" />
            <Grid Grid.Row="2"><ScrollViewer><ItemsControl ItemsSource="{Binding Applications}" Margin="7,3">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Button Command="{Binding DataContext.ConfigureAppCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource Quiet}" HorizontalContentAlignment="Stretch" Padding="10,10" Margin="0,0,0,3" ToolTip="点击查看这个软件的声音去向">
                  <Grid Width="236"><Grid.ColumnDefinitions><ColumnDefinition Width="29" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /></Grid.ColumnDefinitions><Grid VerticalAlignment="Center"><TextBlock Text="♫" Foreground="{DynamicResource Accent.Output}" FontSize="{DynamicResource FontSize.Heading}" HorizontalAlignment="Center" /><Image Source="{Binding Icon}" Width="22" Height="22" /></Grid><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSize.Body}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="175" /><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Text.Muted}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,5,0,0" /></StackPanel><TextBlock Grid.Column="2" Text="›" Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center" /></Grid>
                </Button>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl></ScrollViewer><TextBlock Text="{Binding ApplicationEmptyHint}" Foreground="{DynamicResource Text.Muted}" FontSize="{DynamicResource FontSize.Body}" TextAlignment="Center" Margin="22,34" VerticalAlignment="Top" Visibility="{Binding NoApplications,Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False" /></Grid>
            <StackPanel Grid.Row="3" Margin="17,3,17,8"><Button Content="＋ 添加软件…" Command="{Binding AddApplicationCommand}" Style="{StaticResource Quiet}" Foreground="{DynamicResource Accent.Output}" /><TextBlock Text="没改设置的软件，声音去向不变" Foreground="{DynamicResource Text.Muted}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,7,0,0" /></StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="98" /><RowDefinition Height="*" /><RowDefinition Height="42" /></Grid.RowDefinitions>
          <Border Background="{DynamicResource Surface.Panel}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="61" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding ConfigurationName}" ToolTip="{Binding ConfigurationPath}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text.Secondary}" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding SaveState}" ToolTip="{Binding SaveState}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text.Muted}" FontSize="11" /><TextBlock Grid.Column="2" Text="{Binding ChannelCapacity}" Foreground="{DynamicResource Accent.Input}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ChannelCapacity}" FontSize="11" /></Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border CornerRadius="{DynamicResource Radius.Control}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"><StackPanel Orientation="Horizontal"><Button Content="设置一个软件" Command="{Binding ApplicationViewCommand}" Style="{StaticResource ApplicationViewButton}" Padding="15,10" /><Button Content="查看全部连接" Command="{Binding GlobalViewCommand}" Style="{StaticResource GlobalViewButton}" Padding="15,10" /></StackPanel></Border>
              <Border CornerRadius="{DynamicResource Radius.Tag}" Background="{DynamicResource Surface.Card}" Padding="8,4" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="两页同步" Foreground="{DynamicResource Text.Secondary}" FontSize="{DynamicResource FontSize.Body}" /></Border>
              <TextBlock MaxWidth="110" TextTrimming="CharacterEllipsis" Text="{Binding FocusTitle}" Foreground="{DynamicResource Text.Secondary}" FontSize="{DynamicResource FontSize.Body}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="RunAction" Content="{Binding RunActionLabel}" Command="{Binding RunActionCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="开启或停止声音连接" /><Button x:Name="RestoreOriginal" Content="恢复原设置" Command="{Binding RestoreCommand}" ToolTip="停止声音连接，把声流改过的声音去向、音量和静音恢复到原来。你画的线仍会保留。" /><Button Content="打开" Command="{Binding OpenConfigurationCommand}" Style="{StaticResource Quiet}" /><Button Content="保存" Command="{Binding SaveConfigurationCommand}" Style="{StaticResource Quiet}" /><Button Content="另存为" Command="{Binding SaveAsConfigurationCommand}" Style="{StaticResource Quiet}" /></StackPanel></Grid>
          </Border>
          <Grid Grid.Row="1">
            <n:NodifyEditor x:Name="Editor" ItemsSource="{Binding CanvasNodes}" Connections="{Binding CanvasConnections}" PendingConnection="{Binding Pending}" SelectedItems="{Binding SelectedNodes}" SelectedConnections="{Binding SelectedConnections}" Background="{DynamicResource Surface.Canvas}">
              <n:NodifyEditor.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
                <MenuItem Header="添加软件卡片" Click="AddSoftwareContext" /><MenuItem Header="添加麦克风卡片" Click="AddMicrophoneContext" /><MenuItem Header="添加播放设备卡片" Click="AddPlaybackContext" /><Separator /><MenuItem Header="整理卡片" Click="ArrangeContext" />
              </ContextMenu></n:NodifyEditor.ContextMenu>
              <n:NodifyEditor.ItemContainerStyle><Style TargetType="{x:Type n:ItemContainer}"><Setter Property="Location" Value="{Binding Location,Mode=TwoWay}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="BorderBrush" Value="{DynamicResource Transparent}" /><Setter Property="Background" Value="{DynamicResource Transparent}" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="SelectedBorderThickness" Value="0" /><Setter Property="HighlightBrush" Value="{DynamicResource Transparent}" /><Setter Property="HasCustomContextMenu" Value="True" /></Style></n:NodifyEditor.ItemContainerStyle>
              <n:NodifyEditor.ItemTemplate><DataTemplate DataType="{x:Type vm:NodeViewModel}">
                <Border x:Name="CardSurface" Width="326" CornerRadius="{DynamicResource Radius.Card}" Background="{DynamicResource Surface.Card}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" Padding="0,11">
                  <Border.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="添加软件卡片" Click="AddSoftwareContext" /><MenuItem Header="添加麦克风卡片" Click="AddMicrophoneContext" /><MenuItem Header="添加播放设备卡片" Click="AddPlaybackContext" /><MenuItem Header="选择这个软件用的麦克风" Click="ConfigureRecordingContext" IsEnabled="{Binding SoftwareCard}" /><Separator /><MenuItem Header="复制这个麦克风的名称" Click="CopyInputContext" IsEnabled="{Binding Receiving}" /><MenuItem Header="删除此卡片" Click="DeleteCardContext" IsEnabled="{Binding CanDelete}" />
                  </ContextMenu></Border.ContextMenu>
                  <StackPanel>
                    <Grid Margin="15,0,15,9"><Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid><TextBlock Text="{Binding Glyph}" Foreground="{Binding Accent}" FontSize="{DynamicResource FontSize.Heading}" HorizontalAlignment="Center" /><Image Source="{Binding Icon}" Width="23" Height="23" /></Grid><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="{Binding Category}" Foreground="{Binding Accent}" FontSize="{DynamicResource FontSize.Caption}" /><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{DynamicResource FontSize.CardTitle}" MaxWidth="218" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,4,0,0" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding CardAction}" Foreground="{DynamicResource Text.Muted}" FontSize="{DynamicResource FontSize.Caption}" VerticalAlignment="Top" /></Grid>
                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice,Mode=TwoWay}" ItemTemplate="{StaticResource Choice}" Margin="14,0,14,10" ToolTip="{Binding PickerHint}" Visibility="{Binding CanChooseCard,Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="选择软件或设备" />
                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ItemsControl ItemsSource="{Binding Inputs}" ItemTemplate="{StaticResource InputPort}" HorizontalAlignment="Left" /><ItemsControl Grid.Column="1" ItemsSource="{Binding Outputs}" ItemTemplate="{StaticResource OutputPort}" HorizontalAlignment="Right" /></Grid>
                    <Grid Margin="15,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="接收" Foreground="{DynamicResource Text.Muted}" FontSize="{DynamicResource FontSize.Caption}" /><ProgressBar Value="{Binding InputLevel}" Foreground="{DynamicResource Accent.Input}" Height="3" Margin="0,4,8,0" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="发出" Foreground="{DynamicResource Text.Muted}" FontSize="{DynamicResource FontSize.Caption}" /><ProgressBar Value="{Binding Level}" Foreground="{DynamicResource Accent.Output}" Height="3" Margin="8,4,0,0" /></StackPanel></Grid>
                    <StackPanel Margin="15,10,15,0" Visibility="{Binding AudioSource,Converter={StaticResource BoolVisibility}}">
                      <TextBlock Text="{Binding SourceVolumeTitle}" Foreground="{DynamicResource Text.Muted}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,4" />
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Slider Value="{Binding Volume,Mode=TwoWay}" Minimum="0" Maximum="1" VerticalAlignment="Center" ToolTip="声音大小" /><TextBlock Grid.Column="1" Text="{Binding VolumeLabel}" Foreground="{DynamicResource Text.Secondary}" FontSize="{DynamicResource FontSize.Caption}" VerticalAlignment="Center" HorizontalAlignment="Center" /><CheckBox Grid.Column="2" Content="静音" IsChecked="{Binding Muted}" FontSize="{DynamicResource FontSize.Caption}" /></Grid>


                    </StackPanel>
                    <StackPanel Margin="15,10,15,0" Visibility="{Binding ShowRecordingControls,Converter={StaticResource BoolVisibility}}">
                      <TextBlock Text="这个软件用的麦克风" Foreground="{DynamicResource Accent.Input}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,5" />
                      <ComboBox ItemsSource="{Binding RecordingChoices}" SelectedItem="{Binding RecordingChoice,Mode=TwoWay}" ItemTemplate="{StaticResource Choice}" AutomationProperties.Name="选择这个软件用的麦克风" />
                      <CheckBox Content="使用这个麦克风" IsChecked="{Binding RecordingEnabled,Mode=TwoWay}" Margin="0,7,0,0" ToolTip="取消勾选后，这个软件会听不到声音。需要有一个空着的传声音设备。" />
                      <TextBlock Text="{Binding RecordingStatus}" Foreground="{DynamicResource Text.Muted}" FontSize="{DynamicResource FontSize.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="15,10,15,0" Visibility="{Binding PlaybackCard,Converter={StaticResource BoolVisibility}}">
                      <CheckBox Content="从这个设备播放" IsChecked="{Binding DefaultOutputEnabled,Mode=TwoWay}" Visibility="{Binding HasDefaultOutput,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8" ToolTip="关掉这里，软件就不从这个设备播放；其他连线仍然可用。再次开启时，设备和音量会保持原样。" />
                      <TextBlock Text="这个设备的总音量" Foreground="{DynamicResource Text.Secondary}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,4" />
                      <Grid IsEnabled="{Binding DeviceVolumeAvailable}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Slider Value="{Binding DeviceVolume,Mode=TwoWay}" Minimum="0" Maximum="1" ToolTip="这里的音量和 Windows 里这个设备的音量一致" /><TextBlock Grid.Column="1" Text="{Binding DeviceVolumeLabel}" Foreground="{DynamicResource Text.Secondary}" FontSize="{DynamicResource FontSize.Caption}" VerticalAlignment="Center" HorizontalAlignment="Center" /><CheckBox Grid.Column="2" Content="静音" IsChecked="{Binding DeviceMuted,Mode=TwoWay}" FontSize="{DynamicResource FontSize.Caption}" /></Grid>
                      <TextBlock Text="使用这个设备的软件都会受影响" Foreground="{DynamicResource Text.Muted}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Margin="15,10,15,0" Visibility="{Binding HasInputLevels,Converter={StaticResource BoolVisibility}}"><TextBlock Text="接收哪些声音" Foreground="{DynamicResource Text.Secondary}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,6" /><ItemsControl ItemsSource="{Binding InputLevels}" ItemTemplate="{StaticResource RouteVolumeRow}" /></StackPanel>
                    <StackPanel Margin="15,8,15,0" Visibility="{Binding HasOutputLevels,Converter={StaticResource BoolVisibility}}"><TextBlock Text="发到哪里" Foreground="{DynamicResource Text.Secondary}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,6" /><ItemsControl ItemsSource="{Binding OutputLevels}" ItemTemplate="{StaticResource RouteVolumeRow}" /></StackPanel>
                    <StackPanel Margin="15,7,15,0" Visibility="{Binding Receiving,Converter={StaticResource BoolVisibility}}">
                      <TextBlock Text="传声音用的麦克风" Foreground="{DynamicResource Accent.Input}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,0,0,5" />
                      <TextBlock Text="用它把声音交给这个软件；上面的麦克风选择决定软件实际听到什么" TextWrapping="Wrap" Foreground="{DynamicResource Text.Muted}" FontSize="11" />
                      <TextBlock Text="{Binding InputDeviceName}" Foreground="{DynamicResource Text.Secondary}" FontSize="{DynamicResource FontSize.Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,5,0,0" ToolTip="{Binding InputHelp}" />
                    </StackPanel>
                    <TextBlock Text="{Binding LinkSummary}" Foreground="{DynamicResource Text.Muted}" FontSize="{DynamicResource FontSize.Caption}" Margin="15,9,15,0" /><TextBlock Text="{Binding Status}" Foreground="{Binding Accent}" FontSize="{DynamicResource FontSize.Caption}" Margin="15,4,15,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                  </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                  <Trigger SourceName="CardSurface" Property="IsMouseOver" Value="True"><Setter TargetName="CardSurface" Property="BorderBrush" Value="{DynamicResource Border.Hover}" /></Trigger>
                  <DataTrigger Binding="{Binding IsSelected,RelativeSource={RelativeSource AncestorType={x:Type n:ItemContainer}}}" Value="True"><Setter TargetName="CardSurface" Property="BorderBrush" Value="{DynamicResource Accent.Output}" /><Setter TargetName="CardSurface" Property="Background" Value="{DynamicResource Surface.Card.Selected}" /></DataTrigger>
                  <DataTrigger Binding="{Binding IsPreviewingSelection,RelativeSource={RelativeSource AncestorType={x:Type n:ItemContainer}}}" Value="True"><Setter TargetName="CardSurface" Property="BorderBrush" Value="{DynamicResource Accent.Output}" /></DataTrigger>
                  <DataTrigger Binding="{Binding (n:PendingConnection.IsOverElement),RelativeSource={RelativeSource AncestorType={x:Type n:ItemContainer}}}" Value="True"><Setter TargetName="CardSurface" Property="BorderBrush" Value="{DynamicResource Border.Focus}" /></DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate></n:NodifyEditor.ItemTemplate>
              <n:NodifyEditor.ConnectionTemplate><DataTemplate DataType="{x:Type vm:ConnectionViewModel}"><vm:FlowConnection IsDisconnected="{Binding IsDisconnected}" IsFlowing="{Binding Flowing}" HasSignal="{Binding Active}" Source="{Binding Source.Anchor}" Target="{Binding Target.Anchor}" Stroke="{Binding Source.Color}" StrokeThickness="2.8" ToolTip="{Binding Description}" PreviewMouseLeftButtonDown="ConnectionMouseLeftButtonDown"></vm:FlowConnection></DataTemplate></n:NodifyEditor.ConnectionTemplate>
              <n:NodifyEditor.PendingConnectionTemplate><DataTemplate><n:PendingConnection SourceAnchor="{Binding Source.Anchor}" StartedCommand="{Binding StartCommand}" CompletedCommand="{Binding CompleteCommand}" Stroke="{DynamicResource Accent.Output}" StrokeThickness="3" EnablePreview="True" EnableSnapping="True" IsVisible="{Binding Visible,Mode=OneWay}" /></DataTemplate></n:NodifyEditor.PendingConnectionTemplate>
            </n:NodifyEditor>
            <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="{DynamicResource Surface.Overlay}" CornerRadius="{DynamicResource Radius.Control}" Padding="13,8" Margin="15,13" IsHitTestVisible="False"><StackPanel><TextBlock Text="{Binding ViewHint}" Foreground="{DynamicResource Text.Muted}" FontSize="{DynamicResource FontSize.Caption}" /><TextBlock Text="从右边的圆点拖到左边的圆点" Foreground="{DynamicResource Text.Muted}" FontSize="{DynamicResource FontSize.Caption}" Margin="0,4,0,0" /></StackPanel></Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,18"><Button Content="撤销" Command="{Binding UndoCommand}" Style="{StaticResource Quiet}" /><Button Content="重做" Command="{Binding RedoCommand}" Style="{StaticResource Quiet}" /><Button Content="显示全部卡片" Click="FitClick" Style="{StaticResource Quiet}" /></StackPanel>
            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="{DynamicResource Surface.Overlay}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Card}" Padding="13,8" Margin="0,0,0,20" IsHitTestVisible="False"><TextBlock Text="{Binding Counts}" Foreground="{DynamicResource Text.Muted}" FontSize="{DynamicResource FontSize.Caption}" /></Border>
          </Grid>
          <Border Grid.Row="2" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,1,0,0" Padding="17,10" Background="{DynamicResource Surface.Panel}"><TextBlock Text="{Binding Notice}" Foreground="{DynamicResource Text.Secondary}" FontSize="{DynamicResource FontSize.Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Notice}" /></Border>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
